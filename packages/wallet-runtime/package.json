{
  "name": "@hisoka/wallet-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix"
  },
  "author": "hisoka-io",
  "license": "Apache-2.0",
  "dependencies": {
    "@aztec/foundation": "2.1.11",
    "@hisoka/howl-protocol": "workspace:*",
    "@hisoka/wallets": "workspace:*",
    "@zk-kit/baby-jubjub": "1.0.3",
    "ethers": "6.16.0"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "tsup": "8.5.1",
    "typescript": "5.9.2",
    "vitest": "1.6.1"
  }
}
