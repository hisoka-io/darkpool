{
  "name": "@hisoka/howl-protocol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./proving": {
      "import": {
        "types": "./dist/proving/index.d.ts",
        "default": "./dist/proving/index.js"
      },
      "require": {
        "types": "./dist/proving/index.d.cts",
        "default": "./dist/proving/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "test:bundle": "node scripts/browser-bundle.mjs",
    "test:exports": "tsc --noEmit -p tsconfig.exports.json && node scripts/export-smoke.mjs"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "esbuild": "0.27.7",
    "tsup": "8.5.1",
    "typescript": "5.9.2",
    "vitest": "1.6.1"
  }
}
