PSS_HOST=127.0.0.1
PSS_PORT=8787

# Absolute path. A relative path resolves against the process working directory, so launching from
# somewhere else opens a different, empty database while the migrations still resolve, which looks like
# a healthy server that has lost every account. Set this explicitly in any real deployment: the built-in
# default sits inside the install directory, which is wrong for a mounted volume or a read-only image.
PSS_DATABASE_PATH=/var/lib/pss/pss.db
