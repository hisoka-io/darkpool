{
  "name": "@hisoka/howl-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "pretest": "bash ../../scripts/check-node.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "author": "hisoka-io",
  "license": "Apache-2.0",
  "devDependencies": {
    "@aztec/foundation": "2.1.11",
    "@hisoka/prover": "workspace:*",
    "@hisoka/pss-client": "workspace:*",
    "@hisoka/wallets": "workspace:*",
    "@types/node": "^24.10.0",
    "@zk-kit/baby-jubjub": "^1.0.3",
    "tsup": "^8.5.1",
    "typescript": "5.9.2",
    "vitest": "^1.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
